{
  "name": "@alexpavlov/stylelint-config-rational-order",
  "version": "0.2.0",
  "description": "Stylelint config that sorts related property declarations by grouping together following the order: Positioning, Box Model, Typography, Visual, Animation, Other.",
  "author": "Constverum <constverum@gmail.com>",
  "license": "Apache-2.0",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./plugin": "./plugin/index.js",
    "./borderInBoxModel": "./borderInBoxModel.js",
    "./package.json": "./package.json"
  },
  "files": [
    "config",
    "groups",
    "plugin",
    "index.js",
    "borderInBoxModel.js"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexPavlof/stylelint-config-rational-order.git"
  },
  "bugs": {
    "url": "https://github.com/AlexPavlof/stylelint-config-rational-order/issues"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js"
  },
  "jest": {
    "transform": {}
  },
  "keywords": [
    "stylelint",
    "stylelint-config",
    "stylelint-order",
    "stylelint-plugin",
    "properties-order",
    "css property order",
    "declaration-order",
    "css declaration order",
    "rational-css",
    "order-css",
    "order"
  ],
  "peerDependencies": {
    "stylelint": "^17",
    "stylelint-order": "^8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.1",
    "globals": "^17.11.0",
    "jest": "^30",
    "prettier": "^3.9.6",
    "stylelint": "^17",
    "stylelint-order": "^8"
  },
  "homepage": "https://github.com/AlexPavlof/stylelint-config-rational-order"
}
